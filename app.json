{
  "expo": {
    "name": "Neural Consciente",
    "slug": "neural-consciente",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/neural.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ducode.neural",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSHealthShareUsageDescription": "Neural necesita acceso a tus datos de salud para sincronizar tus entrenamientos, pasos, calorías y actividad física con tu cuenta.",
        "NSHealthUpdateUsageDescription": "Neural necesita escribir datos de entrenamiento en la app Salud para mantener tus registros actualizados."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "splash": {
        "image": "./assets/neural.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.ducode.neural",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#45FFB7",
          "sounds": [],
          "defaultChannel": "default"
        }
      ],
      [
        "react-native-health",
        {
          "healthSharePermission": "Neural necesita acceso a tus datos de salud para sincronizar tus entrenamientos, pasos, calorías y actividad física con tu cuenta.",
          "healthUpdatePermission": "Neural necesita escribir datos de entrenamiento en la app Salud para mantener tus registros actualizados.",
          "isClinicalDataEnabled": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a102b2eb-a288-4cc2-bedf-de73706277fa"
      }
    },
    "owner": "ducode"
  }
}
